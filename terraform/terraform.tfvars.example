# ─────────────────────────────────────────────────────────────────────
# OctoWatch — Terraform Variables
# Copy this file to terraform.tfvars and fill in your values.
# ─────────────────────────────────────────────────────────────────────

# Globally unique ACR name (alphanumeric only, 5-50 chars)
acr_name = "octowatchregistry"

# Azure region
# location = "eastus"

# VM size (Standard_D4s_v5 = 4 vCPU, 16 GB RAM)
# vm_size = "Standard_D4s_v5"

# IP addresses allowed to SSH (empty = no SSH access)
# allowed_ssh_cidrs = ["203.0.113.0/24"]

# GitHub OAuth App credentials (required for login)
github_client_id     = ""
github_client_secret = ""

# GitHub App for enterprise sync (optional)
# github_app_id          = ""
# github_enterprise_slug = ""

# Comma-separated GitHub logins for initial admin access
# initial_admin_logins = "jmassardo"
