# OctoWatch — Terraform Variables
# Copy this file to terraform.tfvars and fill in your values.
# DO NOT commit terraform.tfvars — it contains secrets.

location    = "westus2"
environment = "dev"
owner_tag   = "your-github-handle"

extra_tags = {
  project = "octowatch"
}

vm_size           = "Standard_D4ds_v5"
data_disk_size_gb = 256

ssh_public_key  = "ssh-ed25519 AAAA..."
ssh_source_cidr = "*"
dns_label       = "octowatch-dev"

dns_zone_name           = "example.azure.csa-github.com"
dns_zone_resource_group = "csa-shared-resources"
dns_record_name         = "octowatch"
dns_ttl                 = 300

tls_mode      = "letsencrypt"
tls_domain    = "octowatch.example.azure.csa-github.com"
certbot_email = "you@example.com"

ghcr_username  = ""
ghcr_token     = ""
ghcr_image_tag = "latest"
ghcr_owner     = ""

secret_database_url      = ""
secret_secret_key        = ""
secret_encryption_key    = ""
secret_valkey_url        = ""
secret_valkey_password   = ""
secret_postgres_user     = ""
secret_postgres_password = ""
secret_postgres_db       = ""

secret_github_client_id     = ""
secret_github_client_secret = ""

secret_github_rules_repo  = ""
secret_github_rules_token = ""

secret_initial_admin_logins = ""
secret_app_base_url         = ""

secret_github_app_id          = ""
secret_github_app_private_key = ""
secret_github_enterprise_slug = ""
secret_maxmind_license_key    = ""
secret_okta_org_url           = ""
secret_okta_api_token         = ""
secret_azure_ad_tenant_id     = ""
secret_azure_ad_client_id     = ""
secret_azure_ad_client_secret = ""
secret_slack_bot_token        = ""
secret_smtp_host              = ""
secret_smtp_username          = ""
secret_smtp_password          = ""
secret_jira_url               = ""
secret_jira_username          = ""
secret_jira_api_token         = ""

aks_node_size         = "Standard_D4s_v4"
aks_cutover_complete  = false
aks_ingress_lb_ip     = ""
argocd_admin_password = ""
argocd_github_pat     = ""
letsencrypt_email     = ""

enable_disk_encryption_set             = false
enable_defender                        = false
enable_auto_shutdown                   = false
auto_shutdown_time                     = "0200"
secret_azure_storage_connection_string = ""

k8s_cutover_complete = false
