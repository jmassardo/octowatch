    {
      "mode": "data",
      "type": "cloudinit_config",
      "name": "main",
      "provider": "provider[\"registry.terraform.io/hashicorp/cloudinit\"]",
      "instances": [
        {
          "schema_version": 0,
          "attributes": {
            "base64_encode": true,
            "boundary": "MIMEBOUNDARY",
            "gzip": true,
            "id": "1453557077",
            "part": [
              {
                "content": "#cloud-config\n# OctoWatch cloud-init bootstrap for Ubuntu 24.04 LTS\n# Environment: dev\n# Generated by Terraform — do not edit on the VM.\n\npackage_update: true\npackage_upgrade: true\n\npackages:\n  - apt-transport-https\n  - ca-certificates\n  - curl\n  - gnupg\n  - lsb-release\n  - jq\n  - git\n  - unzip\n  - python3-pip\n  - certbot\n  - postgresql-client\n\nwrite_files:\n\n  # ── Docker daemon configuration ──────────────────────────────────────────────\n  # - JSON log driver with rotation (max 100 MB × 3 files)\n  # - live-restore: containers keep running during daemon upgrades\n  # - userns-remap: run containers as unprivileged user namespace (defence-in-depth)\n  # - no-new-privileges: prevent privilege escalation inside containers\n  - path: /etc/docker/daemon.json\n    owner: root:root\n    permissions: '0644'\n    content: |\n      {\n        \"log-driver\": \"json-file\",\n        \"log-opts\": {\n          \"max-size\": \"100m\",\n          \"max-file\": \"3\"\n        },\n        \"live-restore\": true,\n        \"userns-remap\": \"default\",\n        \"no-new-privileges\": true\n      }\n\n  # ── SSH hardening ─────────────────────────────────────────────────────────────\n  - path: /etc/ssh/sshd_config.d/99-octowatch.conf\n    owner: root:root\n    permissions: '0600'\n    content: |\n      # OctoWatch SSH hardening — managed by cloud-init\n      PasswordAuthentication no\n      PermitRootLogin no\n      PubkeyAuthentication yes\n      AuthorizedKeysFile .ssh/authorized_keys\n      MaxAuthTries 3\n      LoginGraceTime 30\n      ClientAliveInterval 300\n      ClientAliveCountMax 2\n      X11Forwarding no\n      AllowAgentForwarding no\n      AllowTcpForwarding no\n      PermitTunnel no\n      Banner none\n\n  # ── Systemd service unit ──────────────────────────────────────────────────────\n  # Starts the Docker Compose stack on boot after docker.service is ready.\n  - path: /etc/systemd/system/octowatch.service\n    owner: root:root\n    permissions: '0644'\n    content: |\n      [Unit]\n      Description=OctoWatch Docker Compose Stack\n      Documentation=https://github.com/jmassardo/octowatch\n      Requires=docker.service\n      After=docker.service network-online.target\n\n      [Service]\n      Type=oneshot\n      RemainAfterExit=yes\n      WorkingDirectory=/opt/octowatch/compose\n      ExecStart=/usr/bin/docker compose up -d --remove-orphans\n      ExecStop=/usr/bin/docker compose down --timeout 30\n      User=root\n      StandardOutput=journal\n      StandardError=journal\n      TimeoutStartSec=300\n\n      [Install]\n      WantedBy=multi-user.target\n\n  # ── PostgreSQL backup script ──────────────────────────────────────────────────\n  # Runs from cron (daily at 03:00 UTC). Uses managed identity for Azure auth.\n  # Requires: pg_dump installed (postgresql-client package), az CLI.\n  - path: /opt/octowatch/scripts/backup-azure.sh\n    owner: root:root\n    permissions: '0750'\n    content: |\n      #!/bin/bash\n      # OctoWatch — PostgreSQL backup to Azure Blob Storage\n      # Authenticates via VM managed identity (no stored credentials).\n      set -euo pipefail\n\n      STORAGE_ACCOUNT=\"stoctowatchdevbn3idw\"\n      CONTAINER=\"pg-backups\"\n      LOG_PREFIX=\"[octowatch-backup]\"\n      BACKUP_DATE=$(date +%Y%m%d-%H%M%S)\n      BLOB_PATH=\"$(date +%Y/%m/%d)/$BACKUP_DATE.sql.gz\"\n      BACKUP_FILE=\"/tmp/octowatch-$BACKUP_DATE.sql.gz\"\n\n      echo \"$LOG_PREFIX Starting backup: $BACKUP_DATE\"\n\n      # Load application environment (DATABASE_URL etc.)\n      if [ -f /opt/octowatch/compose/.env ]; then\n        set -a\n        # shellcheck disable=SC1091\n        source /opt/octowatch/compose/.env\n        set +a\n      else\n        echo \"$LOG_PREFIX ERROR: .env file not found\" \u003e\u00262\n        exit 1\n      fi\n\n      if [ -z \"${DATABASE_URL:-}\" ]; then\n        echo \"$LOG_PREFIX ERROR: DATABASE_URL is not set\" \u003e\u00262\n        exit 1\n      fi\n\n      # Dump the PostgreSQL database and compress inline.\n      echo \"$LOG_PREFIX Dumping database...\"\n      pg_dump \"$DATABASE_URL\" | gzip \u003e \"$BACKUP_FILE\"\n      BACKUP_SIZE=$(du -sh \"$BACKUP_FILE\" | cut -f1)\n      echo \"$LOG_PREFIX Dump complete: $BACKUP_SIZE\"\n\n      # Upload to Azure Blob Storage using managed identity.\n      echo \"$LOG_PREFIX Uploading to Azure Blob Storage: $BLOB_PATH\"\n      az storage blob upload \\\n        --account-name \"$STORAGE_ACCOUNT\" \\\n        --container-name \"$CONTAINER\" \\\n        --name \"$BLOB_PATH\" \\\n        --file \"$BACKUP_FILE\" \\\n        --account-key \"mz1cBam7gZEnJuBqlTvTo9oaX1si+XuSvpn8nBDzQZo2tSvKYANRTVey3H34JVbEn6/IVzhAGe+N+ASt50Zj4Q==\" \\\n        --overwrite\n\n      # Clean up local temp file.\n      rm -f \"$BACKUP_FILE\"\n\n      echo \"$LOG_PREFIX Backup completed successfully: gs://$STORAGE_ACCOUNT/$CONTAINER/$BLOB_PATH\"\n\n  # ── nginx.conf (base64-encoded from repo source) ──────────────────────────────\n  - path: /opt/octowatch/nginx/nginx.conf\n    owner: root:root\n    permissions: '0644'\n    encoding: b64\n    content: \n\n  # ── docker-compose.yml (base64-encoded, GHCR images + bind-mount volumes) ─────\n  # The compose file has been modified from the repo source:\n  #   - Image names updated to ghcr.io/jmassardo/octowatch-*:latest\n  #   - Top-level volumes replaced with bind-mount entries pointing to the data disk\n  #   - nginx volume paths updated to absolute host paths\n  - path: /opt/octowatch/compose/docker-compose.yml\n    owner: root:root\n    permissions: '0644'\n    encoding: b64\n    content: \n\nruncmd:\n\n  # ── Step 1: Install Docker CE from the official apt repository ────────────────\n  # We install docker-ce (not docker.io) to get the latest stable release with\n  # compose plugin support.\n  - |\n    set -euo pipefail\n    echo \"[cloud-init] Installing Docker CE...\"\n    install -m 0755 -d /etc/apt/keyrings\n    curl -fsSL https://download.docker.com/linux/ubuntu/gpg \\\n      -o /etc/apt/keyrings/docker.asc\n    chmod a+r /etc/apt/keyrings/docker.asc\n    ARCH=$(dpkg --print-architecture)\n    CODENAME=$(. /etc/os-release \u0026\u0026 echo \"$VERSION_CODENAME\")\n    echo \"deb [arch=$ARCH signed-by=/etc/apt/keyrings/docker.asc] \\\n    https://download.docker.com/linux/ubuntu $CODENAME stable\" \\\n      \u003e /etc/apt/sources.list.d/docker.list\n    apt-get update -qq\n    apt-get install -y \\\n      docker-ce \\\n      docker-ce-cli \\\n      containerd.io \\\n      docker-buildx-plugin \\\n      docker-compose-plugin\n    systemctl enable docker\n    systemctl start docker\n    echo \"[cloud-init] Docker CE installed: $(docker --version)\"\n\n  # ── Step 2: Install Azure CLI ─────────────────────────────────────────────────\n  - |\n    set -euo pipefail\n    echo \"[cloud-init] Installing Azure CLI...\"\n    curl -sL https://aka.ms/InstallAzureCLIDeb | bash\n    echo \"[cloud-init] Azure CLI installed: $(az --version | head -1)\"\n\n  # ── Step 3: Create octowatch system user and add to docker group ──────────────\n  - |\n    set -euo pipefail\n    echo \"[cloud-init] Creating octowatch user...\"\n    if ! id octowatch \u0026\u003e/dev/null; then\n      useradd \\\n        --system \\\n        --create-home \\\n        --home-dir /home/octowatch \\\n        --shell /bin/bash \\\n        --comment \"OctoWatch service account\" \\\n        octowatch\n    fi\n    usermod -aG docker octowatch\n    echo \"[cloud-init] User octowatch created and added to docker group.\"\n\n  # ── Step 4: Create application directory structure ────────────────────────────\n  - |\n    set -euo pipefail\n    echo \"[cloud-init] Creating directory structure...\"\n    mkdir -p \\\n      /opt/octowatch/compose \\\n      /opt/octowatch/nginx \\\n      /opt/octowatch/ssl \\\n      /opt/octowatch/certbot-webroot \\\n      /opt/octowatch/scripts\n    # Data disk subdirectories (will exist after disk mount in Step 5)\n    # Created here as placeholders; Step 5 recreates them on the mounted volume.\n    mkdir -p \\\n      /mnt/octowatch-data/pg_data \\\n      /mnt/octowatch-data/valkey_data\n    chown -R octowatch:octowatch /opt/octowatch\n    chmod 750 /opt/octowatch/scripts\n    echo \"[cloud-init] Directory structure created.\"\n\n  # ── Step 5: Format and mount data disk ───────────────────────────────────────\n  # Azure attaches the first data disk (LUN 0) as /dev/sdc on Ubuntu 24.04.\n  # We format it ext4 and add a permanent fstab entry with nofail so the VM\n  # boots cleanly even if the disk is temporarily detached.\n  - |\n    set -euo pipefail\n    DATA_DISK=\"/dev/sdc\"\n    MOUNT_POINT=\"/mnt/octowatch-data\"\n    echo \"[cloud-init] Preparing data disk $DATA_DISK...\"\n\n    # Wait up to 60 seconds for the disk to appear (udev timing).\n    WAITED=0\n    while [ ! -b \"$DATA_DISK\" ] \u0026\u0026 [ $WAITED -lt 60 ]; do\n      echo \"[cloud-init] Waiting for $DATA_DISK... ($WAITED s)\"\n      sleep 5\n      WAITED=$((WAITED + 5))\n    done\n\n    if [ ! -b \"$DATA_DISK\" ]; then\n      echo \"[cloud-init] ERROR: Data disk $DATA_DISK not found after 60s\" \u003e\u00262\n      exit 1\n    fi\n\n    # Format only if the disk has no filesystem (idempotent).\n    FS_TYPE=$(blkid -o value -s TYPE \"$DATA_DISK\" 2\u003e/dev/null || echo \"\")\n    if [ -z \"$FS_TYPE\" ]; then\n      echo \"[cloud-init] Formatting $DATA_DISK as ext4...\"\n      mkfs.ext4 -L octowatch-data -F \"$DATA_DISK\"\n    else\n      echo \"[cloud-init] $DATA_DISK already has filesystem: $FS_TYPE — skipping format.\"\n    fi\n\n    # Mount the data disk.\n    mkdir -p \"$MOUNT_POINT\"\n    mount \"$DATA_DISK\" \"$MOUNT_POINT\"\n\n    # Add fstab entry (nofail ensures boot continues if disk is absent).\n    DISK_UUID=$(blkid -s UUID -o value \"$DATA_DISK\")\n    if ! grep -q \"$DISK_UUID\" /etc/fstab; then\n      echo \"UUID=$DISK_UUID  $MOUNT_POINT  ext4  defaults,nofail,noatime  0  2\" \u003e\u003e /etc/fstab\n      echo \"[cloud-init] Added fstab entry for UUID=$DISK_UUID\"\n    fi\n\n    # Create Docker volume bind-mount directories on the data disk.\n    mkdir -p \\\n      \"$MOUNT_POINT/pg_data\" \\\n      \"$MOUNT_POINT/valkey_data\"\n    chown -R 999:999 \"$MOUNT_POINT/pg_data\"   # PostgreSQL UID\n    chown -R 999:999 \"$MOUNT_POINT/valkey_data\"\n    chmod 700 \"$MOUNT_POINT/pg_data\"\n    echo \"[cloud-init] Data disk mounted at $MOUNT_POINT.\"\n\n  # ── Step 6: Authenticate to Azure via managed identity ────────────────────────\n  - |\n    set -euo pipefail\n    echo \"[cloud-init] Logging in to Azure via managed identity...\"\n    # Retry loop: the IMDS endpoint may not be ready immediately after boot.\n    for i in 1 2 3 4 5; do\n      if az login --identity --username \"18696301-1f53-4e4f-8520-3b83c851bd0a\" --output none 2\u003e/dev/null; then\n        echo \"[cloud-init] Azure login successful.\"\n        break\n      fi\n      echo \"[cloud-init] Azure login attempt $i failed, retrying in 15s...\"\n      sleep 15\n    done\n    az account show --output none || { echo \"[cloud-init] ERROR: Azure login failed\"; exit 1; }\n\n  # ── Step 7: Write .env file (secrets rendered at provision time by Terraform) ──\n  # Secrets are baked into cloud-init userdata at terraform apply time.\n  # This avoids needing Key Vault RBAC role assignments on Contributor-only subs.\n  - |\n    set -euo pipefail\n    ENV_FILE=\"/opt/octowatch/compose/.env\"\n    echo \"[cloud-init] Writing .env file from provisioned secrets...\"\n\n    # Write GitHub App private key to a dedicated file if provided.\n    GITHUB_APP_PRIVATE_KEY_PATH=\"\"\n    \n    cat \u003e \"$ENV_FILE\" \u003c\u003c'ENVEOF'\n# OctoWatch environment — rendered at provision time by Terraform.\n# To update secrets: update terraform.tfvars and re-provision the VM.\n\n# ── Core ──────────────────────────────────────────────────────────────────────\nDATABASE_URL=postgresql://octowatch:M8gkK0JZtjVLYVglbgMNQbvxc6K6m0UtGhCscIUDZQo@db:5432/octowatch\nSECRET_KEY=646e5de983afd27f3248f71c7baa647fd984c866d633dc583a247fa19dd2eccd7982b6fc58d60ad579654ad6f9267c7701f4fb92547166206ae7f81809fc69a9\nENCRYPTION_KEY=Y8V0pBycKW6x82ugZcb4EQWBXJ3_Vhb2qY7wLS-tkRU=\nVALKEY_URL=redis://:BRA_vo_hfgL952Z8doSzevrmzLszumbnx3T9t-pG93k@valkey:6379/0\nVALKEY_PASSWORD=BRA_vo_hfgL952Z8doSzevrmzLszumbnx3T9t-pG93k\n\n# ── PostgreSQL ────────────────────────────────────────────────────────────────\nPOSTGRES_USER=octowatch\nPOSTGRES_PASSWORD=M8gkK0JZtjVLYVglbgMNQbvxc6K6m0UtGhCscIUDZQo\nPOSTGRES_DB=octowatch\n\n# ── GitHub OAuth \u0026 Rules ──────────────────────────────────────────────────────\nGITHUB_CLIENT_ID=Ov23ctoyvthSLYdOGkmw\nGITHUB_CLIENT_SECRET=21aa357dc65f5e7158bc9639b39525371fcb2a2d\nGITHUB_RULES_REPO=\nGITHUB_RULES_TOKEN=\n\n# ── Application ───────────────────────────────────────────────────────────────\nAPP_BASE_URL=https://octowatch.jmassardo.azure.csa-github.com\nINITIAL_ADMIN_LOGINS=jmassardo\nINGESTION_MODE=hec\nLOG_LEVEL=INFO\n\n# ── GitHub App (Enterprise Sync) ──────────────────────────────────────────────\nGITHUB_APP_ID=\nGITHUB_APP_PRIVATE_KEY_PATH=$GITHUB_APP_PRIVATE_KEY_PATH\nGITHUB_ENTERPRISE_SLUG=\nGITHUB_SYNC_ENABLED=false\n\n# ── MaxMind GeoIP ─────────────────────────────────────────────────────────────\nMAXMIND_LICENSE_KEY=\n\n# ── Okta IdP ──────────────────────────────────────────────────────────────────\nOKTA_ORG_URL=\nOKTA_API_TOKEN=\n\n# ── Azure AD / Entra IdP ──────────────────────────────────────────────────────\nAZURE_AD_TENANT_ID=\nAZURE_AD_CLIENT_ID=\nAZURE_AD_CLIENT_SECRET=\n\n# ── Slack Notifications ───────────────────────────────────────────────────────\nSLACK_BOT_TOKEN=\n\n# ── SMTP Notifications ────────────────────────────────────────────────────────\nSMTP_HOST=\nSMTP_PORT=587\nSMTP_USERNAME=\nSMTP_PASSWORD=\nSMTP_FROM_ADDRESS=\n\n# ── Jira Ticketing ────────────────────────────────────────────────────────────\nJIRA_URL=\nJIRA_USERNAME=\nJIRA_API_TOKEN=\nENVEOF\n\n    chmod 600 \"$ENV_FILE\"\n    chown octowatch:octowatch \"$ENV_FILE\"\n    echo \"[cloud-init] .env file written to $ENV_FILE\"\n\n    # Store GHCR token for Step 9.\n    echo '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' \u003e /opt/octowatch/.ghcr_token\n    chmod 600 /opt/octowatch/.ghcr_token\n\n  # ── Step 8: Set correct ownership on compose files ───────────────────────────\n  - |\n    set -euo pipefail\n    chown -R octowatch:octowatch /opt/octowatch/compose\n    chown octowatch:octowatch /opt/octowatch/nginx/nginx.conf\n    echo \"[cloud-init] File ownership set.\"\n\n  # ── Step 9: Authenticate to GHCR ─────────────────────────────────────────────\n  - |\n    set -euo pipefail\n    echo \"[cloud-init] Logging in to GHCR...\"\n    GHCR_TOKEN=$(cat /opt/octowatch/.ghcr_token)\n    echo \"$GHCR_TOKEN\" | docker login ghcr.io \\\n      --username \"jmassardo\" \\\n      --password-stdin\n    rm -f /opt/octowatch/.ghcr_token\n    echo \"[cloud-init] GHCR login successful.\"\n\n  # ── Step 10: TLS certificate provisioning ────────────────────────────────────\n  # Mode: letsencrypt\n  # Domain: octowatch.jmassardo.azure.csa-github.com\n  - |\n    set -euo pipefail\n    TLS_MODE=\"letsencrypt\"\n    TLS_DOMAIN=\"octowatch.jmassardo.azure.csa-github.com\"\n    SSL_DIR=\"/opt/octowatch/ssl\"\n    CERTBOT_WEBROOT=\"/opt/octowatch/certbot-webroot\"\n\n    echo \"[cloud-init] Provisioning TLS certificates (mode: $TLS_MODE, domain: $TLS_DOMAIN)...\"\n\n    if [ \"$TLS_MODE\" = \"letsencrypt\" ]; then\n      # Let's Encrypt: use certbot with webroot authenticator.\n      # nginx must serve /.well-known/acme-challenge/ from $CERTBOT_WEBROOT.\n      # We start a temporary HTTP-only nginx to serve the challenge before\n      # the main stack is up.\n      CERTBOT_EMAIL=\"jmassardo@github.com\"\n      if [ -z \"$CERTBOT_EMAIL\" ]; then\n        echo \"[cloud-init] ERROR: certbot_email is required for letsencrypt mode\" \u003e\u00262\n        exit 1\n      fi\n      certbot certonly \\\n        --webroot \\\n        --webroot-path \"$CERTBOT_WEBROOT\" \\\n        --email \"$CERTBOT_EMAIL\" \\\n        --agree-tos \\\n        --non-interactive \\\n        --domain \"$TLS_DOMAIN\" \\\n        --preferred-challenges http\n      # Symlink Let's Encrypt certs to the expected location.\n      ln -sf \"/etc/letsencrypt/live/$TLS_DOMAIN/fullchain.pem\" \"$SSL_DIR/cert.pem\"\n      ln -sf \"/etc/letsencrypt/live/$TLS_DOMAIN/privkey.pem\"   \"$SSL_DIR/key.pem\"\n      echo \"[cloud-init] Let's Encrypt certificate provisioned for $TLS_DOMAIN.\"\n    else\n      # Self-signed: generate a certificate valid for 10 years.\n      echo \"[cloud-init] Generating self-signed certificate for $TLS_DOMAIN...\"\n      openssl req \\\n        -x509 \\\n        -nodes \\\n        -newkey rsa:4096 \\\n        -keyout \"$SSL_DIR/key.pem\" \\\n        -out    \"$SSL_DIR/cert.pem\" \\\n        -days   3650 \\\n        -subj   \"/CN=$TLS_DOMAIN/O=OctoWatch/C=US\" \\\n        -addext \"subjectAltName=DNS:$TLS_DOMAIN\"\n      echo \"[cloud-init] Self-signed certificate generated.\"\n    fi\n\n    chmod 600 \"$SSL_DIR/key.pem\"\n    chmod 644 \"$SSL_DIR/cert.pem\"\n    chown root:root \"$SSL_DIR/key.pem\" \"$SSL_DIR/cert.pem\"\n\n  # ── Step 11: Pull Docker images from GHCR ────────────────────────────────────\n  - |\n    set -euo pipefail\n    echo \"[cloud-init] Pulling Docker images...\"\n    cd /opt/octowatch/compose\n    docker compose pull\n    echo \"[cloud-init] Docker images pulled.\"\n\n  # ── Step 12: Start the Docker Compose stack ───────────────────────────────────\n  - |\n    set -euo pipefail\n    echo \"[cloud-init] Starting OctoWatch stack...\"\n    cd /opt/octowatch/compose\n    docker compose up -d --remove-orphans\n    echo \"[cloud-init] OctoWatch stack started.\"\n\n  # ── Step 13: Enable and start the systemd service ────────────────────────────\n  - |\n    set -euo pipefail\n    systemctl daemon-reload\n    systemctl enable octowatch.service\n    echo \"[cloud-init] octowatch.service enabled.\"\n\n  # ── Step 14: Set up cron jobs ─────────────────────────────────────────────────\n  - |\n    set -euo pipefail\n\n    # Daily PostgreSQL backup at 03:00 UTC.\n    cat \u003e /etc/cron.d/octowatch-backup \u003c\u003c'CRONEOF'\n    # OctoWatch — daily PostgreSQL backup to Azure Blob Storage\n    0 3 * * * root /opt/octowatch/scripts/backup-azure.sh \u003e\u003e /var/log/octowatch-backup.log 2\u003e\u00261\n    CRONEOF\n    chmod 644 /etc/cron.d/octowatch-backup\n    echo \"[cloud-init] Backup cron installed.\"\n\n    # Let's Encrypt certificate renewal (only when tls_mode=letsencrypt).\n    TLS_MODE=\"letsencrypt\"\n    TLS_DOMAIN=\"octowatch.jmassardo.azure.csa-github.com\"\n    if [ \"$TLS_MODE\" = \"letsencrypt\" ]; then\n      cat \u003e /etc/cron.d/octowatch-certbot \u003c\u003cCRONEOF\n    # OctoWatch — Let's Encrypt renewal check (twice daily per certbot best practice)\n    0 */12 * * * root certbot renew --quiet --webroot \\\n      --webroot-path /opt/octowatch/certbot-webroot \\\n      --post-hook 'cd /opt/octowatch/compose \u0026\u0026 docker compose exec nginx nginx -s reload' \\\n      \u003e\u003e /var/log/letsencrypt/renewal.log 2\u003e\u00261\n    CRONEOF\n      chmod 644 /etc/cron.d/octowatch-certbot\n      echo \"[cloud-init] Certbot renewal cron installed.\"\n    fi\n\n  # ── Step 15: Final health check and log ──────────────────────────────────────\n  - |\n    set -euo pipefail\n    echo \"[cloud-init] Waiting 30s for containers to reach healthy state...\"\n    sleep 30\n    cd /opt/octowatch/compose\n    docker compose ps\n    echo \"[cloud-init] OctoWatch bootstrap complete. Environment: dev\"\n\nfinal_message: |\n  OctoWatch bootstrap complete.\n  Environment: dev\n  Domain: octowatch.jmassardo.azure.csa-github.com\n  TLS mode: letsencrypt\n  Check logs: journalctl -u cloud-final -f\n  Stack status: docker compose -f /opt/octowatch/compose/docker-compose.yml ps\n",
                "content_type": "text/cloud-config",
                "filename": "cloud-init.yaml",
                "merge_type": null
              }
            ],
            "rendered": ""
          },
