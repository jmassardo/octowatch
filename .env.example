# =============================================================================
# OctoWatch — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in the values.
#   cp .env.example .env
#
# All secrets should be randomly generated. You can use:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
# =============================================================================

# --- Core Application --------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://appuser:CHANGEME@db:5432/audit_logs
SECRET_KEY=CHANGEME
VALKEY_URL=redis://:CHANGEME@valkey:6379/0
LOG_LEVEL=INFO
ENVIRONMENT=development
INGESTION_MODE=minio
QUERY_MAX_ROWS=100000
QUERY_TIMEOUT_SECONDS=30
DETECTION_CONFIDENCE_THRESHOLD=0.7

# --- GitHub OAuth App --------------------------------------------------------
# Create at https://github.com/settings/developers → New OAuth App
# Authorization callback URL: https://<your-host>/api/v1/auth/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
APP_BASE_URL=https://localhost

# --- GitHub App — Enterprise Sync (optional) ---------------------------------
# Create a GitHub App at https://github.com/organizations/<org>/settings/apps
# Required permissions (read-only): Organization Members, Repositories, Teams
# After creating, generate a private key (.pem) and mount it in the container.
# These are optional — the setup wizard can configure them via the UI.
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY_PATH=
GITHUB_ENTERPRISE_SLUG=
GITHUB_SYNC_ENABLED=false
GITHUB_SYNC_INTERVAL_DAYS=60
# Comma-separated org logins to sync (empty = all enterprise orgs)
GITHUB_SYNC_ORGS=

# --- Detection Rules Git Repo (optional) -------------------------------------
# Store detection rules in a Git repo for version control
GITHUB_RULES_REPO=
GITHUB_RULES_TOKEN=
GITHUB_RULES_BRANCH=main

# --- SAML SSO (optional — leave blank for GitHub OAuth only) -----------------
SAML_IDP_METADATA_URL=
SAML_SP_CERT=
SAML_SP_KEY=

# --- PostgreSQL (used by docker-compose for DB init) -------------------------
POSTGRES_USER=appuser
POSTGRES_PASSWORD=CHANGEME
POSTGRES_DB=audit_logs

# --- Valkey (Redis-compatible cache) -----------------------------------------
VALKEY_PASSWORD=CHANGEME

# --- MinIO (S3-compatible object storage) ------------------------------------
MINIO_ENDPOINT_URL=http://minio:9000
MINIO_AUDIT_BUCKET=audit-logs
MINIO_ROOT_USER=CHANGE_ME
MINIO_ROOT_PASSWORD=CHANGEME
MINIO_INGEST_USER=ingest-service
MINIO_INGEST_PASSWORD=CHANGEME

# --- GeoIP (optional — enriches events with location data) -------------------
GEOIP_DB_PATH=/app/data/GeoLite2-City.mmdb
MAXMIND_LICENSE_KEY=

# --- Identity Provider Integrations (all optional) ---------------------------
OKTA_ORG_URL=
OKTA_API_TOKEN=
AZURE_AD_TENANT_ID=
AZURE_AD_CLIENT_ID=
AZURE_AD_CLIENT_SECRET=
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_WORKSPACE_DOMAIN=

# --- Ticketing & Notifications (all optional) --------------------------------
JIRA_URL=
JIRA_USERNAME=
JIRA_API_TOKEN=
SLACK_BOT_TOKEN=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=

# --- Cloud Storage Alternatives to MinIO (optional) --------------------------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=
S3_AUDIT_BUCKET=
AZURE_STORAGE_CONNECTION_STRING=
AZURE_AUDIT_CONTAINER=

# --- Bootstrap ---------------------------------------------------------------
# Comma-separated GitHub logins granted sys_admin on first login
INITIAL_ADMIN_LOGINS=
