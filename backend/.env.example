# audit-log-analyzer — environment variables example
# Copy this file to .env and fill in real values.
# NEVER commit .env (with real secrets) to version control.
# All values below are placeholders only.

# ─── Core Application ────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://appuser:CHANGE_ME@localhost:5432/audit_logs?sslmode=require
SECRET_KEY=CHANGE_ME_32_BYTE_HEX_RUN_openssl_rand_m_hex_32
# Master key for encrypting secrets stored in the database.
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
# If empty, SECRET_KEY is used as fallback (not recommended for production).
ENCRYPTION_KEY=CHANGE_ME_32_BYTE_HEX_RUN_python_c_import_secrets_print_secrets_token_hex_32
VALKEY_URL=redis://:CHANGE_ME@localhost:6379/0
LOG_LEVEL=INFO
INGESTION_MODE=minio
GEOIP_DB_PATH=/app/data/GeoLite2-City.mmdb
GITHUB_RULES_REPO=my-org/audit-detection-rules
GITHUB_RULES_TOKEN=CHANGE_ME_GITHUB_PAT_WITH_CONTENTS_WRITE
GITHUB_RULES_BRANCH=main
QUERY_MAX_ROWS=100000
QUERY_TIMEOUT_SECONDS=30
DETECTION_CONFIDENCE_THRESHOLD=0.7
JWT_TTL_SECONDS=3600            # JWT and session TTL in seconds

# ─── GitHub OAuth ────────────────────────────────────────────────────────────
GITHUB_CLIENT_ID=CHANGE_ME
GITHUB_CLIENT_SECRET=CHANGE_ME
# Canonical public base URL (no trailing slash) — used for OAuth callback + SAML ACS
APP_BASE_URL=https://your-app.example.com

# ─── SAML 2.0 ────────────────────────────────────────────────────────────────
SAML_IDP_METADATA_URL=https://your-idp.example.com/metadata.xml
SAML_SP_CERT=CHANGE_ME_PEM_CERTIFICATE
SAML_SP_KEY=CHANGE_ME_PEM_PRIVATE_KEY

# ─── MinIO ───────────────────────────────────────────────────────────────────
MINIO_ENDPOINT_URL=http://minio:9000
MINIO_AUDIT_BUCKET=audit-logs
MINIO_ROOT_USER=CHANGE_ME
MINIO_ROOT_PASSWORD=CHANGE_ME
MINIO_INGEST_USER=ingest-service
MINIO_INGEST_PASSWORD=CHANGE_ME

# ─── AWS S3 (if INGESTION_MODE=s3) ──────────────────────────────────────────
AWS_ACCESS_KEY_ID=CHANGE_ME
AWS_SECRET_ACCESS_KEY=CHANGE_ME
AWS_DEFAULT_REGION=us-east-1
S3_AUDIT_BUCKET=your-audit-log-bucket

# ─── Azure Blob (if INGESTION_MODE=azure_blob) ───────────────────────────────
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=CHANGE_ME;AccountKey=CHANGE_ME;EndpointSuffix=core.windows.net
AZURE_AUDIT_CONTAINER=audit-logs

# ─── GeoIP ───────────────────────────────────────────────────────────────────
MAXMIND_LICENSE_KEY=CHANGE_ME

# ─── Okta IdP Enrichment ─────────────────────────────────────────────────────
OKTA_ORG_URL=https://your-org.okta.com
OKTA_API_TOKEN=CHANGE_ME

# ─── Azure AD / Entra IdP Enrichment ─────────────────────────────────────────
AZURE_AD_TENANT_ID=CHANGE_ME
AZURE_AD_CLIENT_ID=CHANGE_ME
AZURE_AD_CLIENT_SECRET=CHANGE_ME

# ─── Google Workspace IdP Enrichment ─────────────────────────────────────────
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account", ...}
GOOGLE_WORKSPACE_DOMAIN=example.com

# ─── Jira ────────────────────────────────────────────────────────────────────
JIRA_URL=https://your-org.atlassian.net
JIRA_USERNAME=alerts@example.com
JIRA_API_TOKEN=CHANGE_ME

# ─── Slack ───────────────────────────────────────────────────────────────────
SLACK_BOT_TOKEN=xoxb-CHANGE_ME

# ─── SMTP Email ──────────────────────────────────────────────────────────────
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=apikey
SMTP_PASSWORD=CHANGE_ME
SMTP_FROM_ADDRESS=alerts@example.com
