  {
    "name": "Dependency Confusion",
    "slug": "dependency-confusion",
    "description": "Detects when a private package name appears in a public registry install action, indicating a potential dependency confusion attack where an attacker publishes a malicious package with the same name as an internal package to a public registry.",
    "category": "supply_chain",
    "default_severity": "critical",
    "default_confidence": "high",
    "logic_type": "pattern",
    "logic_config": {
      "action_filters": [
        "git.push",
        "workflows.completed_workflow_run"
      ],
      "field_conditions": [
        {
          "field": "action",
          "operator": "in",
          "value": ["git.push", "workflows.completed_workflow_run"]
        }
      ],
      "x_config": {
        "engine": "dependency_confusion",
        "check_public_registry": true,
        "registries": ["npmjs.com", "pypi.org", "rubygems.org"],
        "scope_patterns": ["@internal/*", "@private/*"]
      },
      "confidence": 0.80
    },
    "created_by": "system"
  },
